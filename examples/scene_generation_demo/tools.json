  {
    "name": "assets.search",
    "description": "Search spawnable StaticMesh, SkeletalMesh, and Actor Blueprint assets with bounded pagination.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Asset root path.",
          "default": "/Game/"
        },
        "search_spec": {
          "type": "string",
          "description": "Case-insensitive substring matched against name, type, and path."
        },
        "offset": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1000000,
          "description": "Result offset."
        },
        "limit": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum returned entries; defaults to 30 to protect agent context."
        }
      }
    }
  },
  {
    "name": "camera.frame_bounds",
    "description": "Frame an actor from a preset direction using its bounds and the main camera field of view, keeping the camera outside geometry.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "description": "Actor to frame."
        },
        "preset": {
          "type": "string",
          "description": "View direction preset.",
          "default": "top_down"
        },
        "margin": {
          "type": "number",
          "default": 1.25,
          "minimum": 1.01,
          "maximum": 5,
          "description": "Framing distance multiplier."
        }
      },
      "required": [
        "actor"
      ]
    }
  },
