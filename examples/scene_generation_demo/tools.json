  {
    "name": "spawn.from_asset",
    "description": "Spawn an asset at a position, optionally settle it to ground, annotate it, reject overlap, and return actual bounds and placement state.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "asset_path": {
          "type": "string",
          "description": "Spawnable asset path."
        },
        "location": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "description": "Estimated spawn location in centimeters.",
          "required": [
            "x",
            "y",
            "z"
          ]
        },
        "rotation": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "description": "Optional pitch, yaw, roll mapped to x, y, z.",
          "required": [
            "x",
            "y",
            "z"
          ]
        },
        "name": {
          "type": "string",
          "description": "Optional unique actor name."
        },
        "settle": {
          "type": "string",
          "description": "none, simple, bounds, or sweep.",
          "default": "bounds"
        },
        "height_offset_cm": {
          "type": "number",
          "default": 0,
          "minimum": -100000,
          "maximum": 100000,
          "description": "Final settle height offset."
        },
        "reject_overlaps": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "Reject and roll back if bounds overlap existing actors."
        }
      },
      "required": [
        "asset_path",
        "location"
      ]
    }
