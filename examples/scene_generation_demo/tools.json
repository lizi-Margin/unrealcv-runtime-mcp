  {
    "name": "camera.set_view_preset",
    "description": "Place the camera relative to a target and aim at it. top_down is the default scene-generation view.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "description": "World point at the center of the view.",
          "required": [
            "x",
            "y",
            "z"
          ]
        },
        "preset": {
          "type": "string",
          "description": "top_down/z_positive, bottom_up/z_negative, x_positive, x_negative, y_positive, y_negative, or an x/y axis down_45 preset.",
