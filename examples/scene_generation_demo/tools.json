        "distance_cm": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 1000000,
          "description": "Distance from target to camera."
        }
      },
      "required": [
        "target"
      ]
    }
  },
  {
    "name": "perception.snapshot",
    "description": "Read native structured scene state without image recognition. Returns the agent pose, nearby objects and bounds, line of sight, navigation reachability, radial collision rays, and occupancy capability metadata.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "radius_cm": {
          "type": "number",
          "default": 2500,
          "minimum": 100,
          "maximum": 100000,
          "description": "Radius around the main camera in centimeters."
        },
        "max_objects": {
          "type": "integer",
          "default": 24,
          "minimum": 1,
          "maximum": 64
        },
        "max_rays": {
          "type": "integer",
          "default": 8,
          "minimum": 0,
          "maximum": 16
        }
      }
    }
  },
  {
    "name": "scene.capture_view",
    "description": "Capture a high-quality lit MCP image using MQRC or the main viewport backbuffer. This tool never uses a UBaseCameraSensor subclass.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "camera_id": {
          "type": "integer",
          "default": 0
        },
        "source": {
          "type": "string",
          "description": "High-quality lit render source. Use 'mqrc' (default) or 'viewport'. BaseCameraSensor channels are deliberately unavailable.",
          "default": "mqrc",
          "enum": [
            "mqrc",
            "viewport"
          ]
        },
        "width": {
          "type": "integer",
          "default": 640,
          "minimum": 160,
          "maximum": 1280
        },
        "height": {
          "type": "integer",
          "default": 360,
          "minimum": 90,
          "maximum": 720
        }
      }
    }
  },
